  "characters": [
    {
      "id": "A",
      "name": "Tom",
      "tts_voice": "en-US-AndrewNeural"
    },
    {
      "id": "B",
      "name": "Jessica",
      "tts_voice": "en-US-JennyNeural"
    }
  ],
  "dialogues": [
    {
      "role": "A",
      "start_time": 1.366,
      "end_time": 2.166,
      "en": "Hey babe!",
      "vi": "Này babe!"
    },
    {
      "role": "A",
      "start_time": 2.166,
      "end_time": 3.633,
      "en": "I'm on my way to pick you up.",
      "vi": "Anh đang trên đường đến đón em."
    },
    {
      "role": "A",
      "start_time": 3.633,
      "end_time": 4.800,
      "en": "Are you ready?",
      "vi": "Em sẵn sàng chưa?"
    },
    {
      "role": "B",
      "start_time": 5.000,
      "end_time": 6.133,
      "en": "Almost!",
      "vi": "Gần xong rồi!"
    },
    {
      "role": "A",
      "start_time": 6.966,
      "end_time": 10.000,
      "en": "So... that means like 30 more minutes?",
      "vi": "Vậy... nghĩa là khoảng 30 phút nữa hả?"
    },
    {
      "role": "B",
      "start_time": 11.066,
      "end_time": 13.700,
      "en": "Hey! I'm actually almost done, I swear!",
      "vi": "Này! Em thực sự gần xong rồi, em thề!"
    },
    {
      "role": "A",
      "start_time": 13.700,
      "end_time": 16.366,
      "en": "It's all good, honey.",
      "vi": "Không sao đâu, honey."
    },
    {
      "role": "A",
      "start_time": 16.366,
      "end_time": 18.366,
      "en": "No rush. Take your time.",
      "vi": "Không cần vội. Em cứ từ từ."
    },
    {
      "role": "B",
      "start_time": 18.566,
      "end_time": 20.066,
      "en": "How far are you now?",
      "vi": "Bây giờ anh còn bao xa nữa?"
    },
    {
      "role": "A",
      "start_time": 21.000,
      "end_time": 22.200,
      "en": "About ten minutes.",
      "vi": "Khoảng mười phút."
    },
    {
      "role": "A",
      "start_time": 22.200,
      "end_time": 24.433,
      "en": "I can just chill at the park near your place",
      "vi": "Anh có thể chờ ở công viên gần nhà em"
    },
    {
      "role": "A",
      "start_time": 24.433,
      "end_time": 26.000,
      "en": "if you're not ready yet.",
      "vi": "nếu em chưa sẵn sàng."
    },
    {
      "role": "B",
      "start_time": 26.700,
      "end_time": 30.333,
      "en": "A park? There's no park near my house.",
      "vi": "Công viên? Gần nhà em không có công viên nào cả."
    },
    {
      "role": "A",
      "start_time": 30.800,
      "end_time": 32.000,
      "en": "Wait, really?",
      "vi": "Khoan, thật sao?"
    },
    {
      "role": "A",
      "start_time": 32.000,
      "end_time": 34.000,
      "en": "But I just drove by.",
      "vi": "Nhưng anh vừa lái xe qua mà."
    },
    {
      "role": "B",
      "start_time": 35.100,
      "end_time": 37.333,
      "en": "Are you sure you have the right address?",
      "vi": "Anh chắc là mình có đúng địa chỉ chứ?"
    },
    {
      "role": "A",
      "start_time": 38.233,
      "end_time": 41.600,
      "en": "Yeah... 154 Oak Street, right?",
      "vi": "Ừ... 154 đường Oak, đúng không?"
    },
    {
      "role": "B",
      "start_time": 42.466,
      "end_time": 44.200,
      "en": "No! It's 154 Elm Street!",
      "vi": "Không! Là 154 đường Elm!"
    },
    {
      "role": "B",
      "start_time": 44.200,
      "end_time": 49.133,
      "en": "Oak Street's like an hour away from me!",
      "vi": "Đường Oak cách em khoảng một tiếng đường!"
    },
    {
      "role": "A",
      "start_time": 49.466,
      "end_time": 50.966,
      "en": "Oh no...",
      "vi": "Ồ không..."
    },
    {
      "role": "B",
      "start_time": 51.200,
      "end_time": 53.166,
      "en": "How did you forget my address?",
      "vi": "Sao anh lại quên địa chỉ của em thế?"
    },
    {
      "role": "A",
      "start_time": 54.100,
      "end_time": 55.866,
      "en": "Ugh... my bad!",
      "vi": "Ugh... lỗi của anh!"
    },
    {
      "role": "A",
      "start_time": 55.866,
      "end_time": 58.800,
      "en": "But on the bright side, you have more time to get ready,",
      "vi": "Nhưng nhìn mặt tích cực thì, em có thêm thời gian để chuẩn bị,"
    },
    {
      "role": "A",
      "start_time": 58.800,
      "end_time": 59.600,
      "en": "right?",
      "vi": "đúng không?"
    }
  ]
}